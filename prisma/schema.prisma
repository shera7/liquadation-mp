// Схема базы данных проекта "Цифровая витрина ликвидационного имущества"
// Фаза 1 (MVP): каталог, категории, товары, заявки.
// Поля под Фазу 2/3 (роли, история статусов, документы, валютные курсы)
// уже заложены в структуре, чтобы не переделывать миграции позже.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Категории (дерево: категория -> подкатегория) ----------
model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([parentId])
}

enum ProductStatus {
  IN_STOCK    // В продаже
  RESERVED    // Забронировано
  SOLD        // Продано
  WITHDRAWN   // Снято с продажи
}

enum ProductCondition {
  NEW
  USED
  NEEDS_REPAIR
}

enum Currency {
  USD
  UZS
}

model Product {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  inventoryNumber  String            @unique // артикул / инвентарный номер
  description      String?           @db.Text
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])

  status           ProductStatus     @default(IN_STOCK)
  condition        ProductCondition  @default(USED)

  quantity         Int               @default(1)
  unit             String            @default("шт")     // единица измерения

  price            Decimal?          @db.Decimal(14, 2) // null = "цена по запросу"
  currency         Currency          @default(USD)
  priceOnRequest   Boolean           @default(false)

  location         String?           // местонахождение

  // технические характеристики для оборудования — гибкое поле,
  // чтобы не плодить колонки под каждую категорию на MVP
  manufacturer     String?
  model            String?
  year             Int?
  power            String?           // мощность
  specs            Json?             // { "Диаметр": "500 мм", "Вес": "1200 кг", ... }

  viewsCount       Int               @default(0)

  images           ProductImage[]
  documents        ProductDocument[]
  requests         Request[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([title])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String   // напр. "Технический паспорт.pdf"
  url       String
  createdAt DateTime @default(now())

  @@index([productId])
}

enum RequestType {
  PRODUCT   // заявка по конкретному товару
  GENERAL   // быстрая заявка без товара ("ищу оборудование")
}

enum RequestStatus {
  NEW               // Новая
  IN_PROGRESS       // В работе
  CONTACTED         // Связались
  NEGOTIATION       // Переговоры
  RESERVED          // Забронировано
  SOLD              // Продано
  REJECTED          // Отказ
  UNREACHABLE       // Не удалось связаться
}

model Request {
  id            String        @id @default(cuid())
  type          RequestType   @default(PRODUCT)

  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])

  name          String
  company       String?
  phone         String
  telegram      String?
  whatsapp      String?
  email         String?

  quantity      Int?
  desiredPrice  String?
  contactMethod String?       // предпочитаемый способ связи

  // поля для GENERAL-заявки
  interestedCategory String?
  budget              String?

  comment       String?       @db.Text

  status        RequestStatus @default(NEW)
  managerNote   String?       @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([productId])
}

enum AdminRole {
  FULL       // Полный контроль
  MODERATOR  // Модерация: товары, категории, заявки
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MODERATOR)
  createdAt    DateTime  @default(now())
}
