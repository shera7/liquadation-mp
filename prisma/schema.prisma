// Схема базы данных проекта "Цифровая витрина ликвидационного имущества"
// Фаза 1 (MVP): каталог, категории, товары, заявки.
// Поля под Фазу 2/3 (роли, история статусов, документы, валютные курсы)
// уже заложены в структуре, чтобы не переделывать миграции позже.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Категории (дерево: категория -> подкатегория) ----------
model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([parentId])
}

enum ProductStatus {
  IN_STOCK    // В продаже
  RESERVED    // Забронировано
  SOLD        // Продано
  WITHDRAWN   // Снято с продажи
}

enum ProductCondition {
  NEW
  USED
  NEEDS_REPAIR
}

enum Currency {
  USD
  UZS
}

model Product {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  inventoryNumber  String            @unique // артикул / инвентарный номер
  description      String?           @db.Text
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])

  status           ProductStatus     @default(IN_STOCK)
  condition        ProductCondition  @default(USED)

  quantity         Int               @default(1)
  unit             String            @default("шт")     // единица измерения

  price            Decimal?          @db.Decimal(14, 2) // null = "цена по запросу"
  oldPrice         Decimal?          @db.Decimal(14, 2) // старая цена — показывается зачёркнутой
  priceLabel       String?           // текстовая метка у цены, напр. "Лучшая цена"
  currency         Currency          @default(USD)
  priceOnRequest   Boolean           @default(false)

  location         String?           // местонахождение

  // технические характеристики для оборудования — гибкое поле,
  // чтобы не плодить колонки под каждую категорию на MVP
  manufacturer     String?
  model            String?
  year             Int?
  power            String?           // мощность
  specs            Json?             // { "Диаметр": "500 мм", "Вес": "1200 кг", ... }

  viewsCount       Int               @default(0)

  images           ProductImage[]
  documents        ProductDocument[]
  requests         Request[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([title])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String   // напр. "Технический паспорт.pdf"
  url       String
  createdAt DateTime @default(now())

  @@index([productId])
}

enum RequestType {
  PRODUCT   // заявка по конкретному товару
  GENERAL   // быстрая заявка без товара ("ищу оборудование")
}

enum RequestStatus {
  NEW               // Новая
  IN_PROGRESS       // В работе
  CONTACTED         // Связались
  NEGOTIATION       // Переговоры
  RESERVED          // Забронировано
  SOLD              // Продано
  REJECTED          // Отказ
  UNREACHABLE       // Не удалось связаться
}

model Request {
  id            String        @id @default(cuid())
  type          RequestType   @default(PRODUCT)

  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])

  name          String
  company       String?
  phone         String
  ip            String?

  seq             Int      @unique @default(autoincrement())
  requestNumber   String?  @unique
  assigneeId      String?
  assigneeName    String?
  statusChangedAt DateTime @default(now())

  history  RequestHistory[]
  comments RequestComment[]

  ndaAcceptanceId String?
  ndaAcceptance   NdaAcceptance? @relation(fields: [ndaAcceptanceId], references: [id])
  telegram      String?
  whatsapp      String?
  email         String?

  quantity      Int?
  desiredPrice  String?
  contactMethod String?       // предпочитаемый способ связи

  // поля для GENERAL-заявки
  interestedCategory String?
  budget              String?

  comment       String?       @db.Text

  status        RequestStatus @default(NEW)
  managerNote   String?       @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([productId])
}

enum AdminRole {
  FULL       // Полный контроль
  MODERATOR  // Модерация: товары, категории, заявки
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MODERATOR)
  createdAt    DateTime  @default(now())
}

model SiteSettings {
  id                    String   @id @default("singleton")
  siteName              String   @default("Актив.Каталог")
  contactPhone          String?
  contactEmail          String?
  contactTelegram       String?
  contactWhatsapp       String?
  telegramBotToken      String?
  telegramManagerChatId String?
  telegramBotUsername   String?
  updatedAt             DateTime @updatedAt
  ndaBotToken      String?
  ndaBotUsername   String?
  ndaWebhookSecret String?
  faviconUrl      String?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  usdToUzsRate       Decimal?  @db.Decimal(14, 4)
  usdToUzsRateDate   String?
  usdToUzsUpdatedAt  DateTime?
  currencyRateSource String    @default("auto")
  ndaMinPriceUsd Decimal? @db.Decimal(14, 2)
}

enum NdaDocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model NdaDocument {
  id            String            @id @default(cuid())
  version       String
  title         String
  content       String            @db.Text
  contentHash   String
  status        NdaDocumentStatus @default(DRAFT)
  effectiveFrom DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  acceptances   NdaAcceptance[]
}

model NdaAcceptance {
  id                 String      @id @default(cuid())
  telegramId         String
  telegramUsername   String?
  telegramFirstName  String?
  ndaDocumentId      String
  ndaDocument        NdaDocument @relation(fields: [ndaDocumentId], references: [id])
  ndaVersion         String
  documentHash       String
  verificationMethod String      @default("TELEGRAM_WIDGET")
  signedAt           DateTime    @default(now())
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime    @default(now())

  requests           Request[]

  @@index([telegramId])
}

model NdaOtpSession {
  id                String    @id @default(cuid())
  token             String    @unique
  ip                String?
  ndaDocumentId     String?
  telegramChatId    String?
  telegramUsername  String?
  telegramFirstName String?
  codeHash          String?
  codeSentAt        DateTime?
  expiresAt         DateTime?
  attempts          Int       @default(0)
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([token])
  @@index([ip])
}

model SlaRule {
  status    RequestStatus @id
  hours     Int           @default(24)
  isFinal   Boolean       @default(false)
  updatedAt DateTime      @updatedAt
}

model RequestHistory {
  id             String         @id @default(cuid())
  requestId      String
  request        Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedById    String?
  changedByName  String?
  previousStatus RequestStatus?
  newStatus      RequestStatus
  comment        String?
  createdAt      DateTime       @default(now())

  @@index([requestId])
}

model RequestComment {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([requestId])
}
